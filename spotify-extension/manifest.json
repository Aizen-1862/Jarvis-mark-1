{
  "manifest_version": 3,
  "name": "JARVIS Spotify Search Player",
  "version": "1.0.0",
  "description": "Starts the first Spotify search result and launches a small allowlist of Windows apps for JARVIS.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/search/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
